# ========================================
# Digital Twin Greenhouse - Configuration
# ========================================

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-token
INFLUXDB_ORG=greenhouse
INFLUXDB_BUCKET=telemetry

# Simulator
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_ENABLED=true

# ML
ML_FORECAST_HORIZON_MINUTES=60
ML_ANOMALY_SENSITIVITY=0.05

# Google Gemini AI (get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
